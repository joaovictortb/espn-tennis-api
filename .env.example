PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# ESPN upstream
ESPN_TIMEOUT_MS=12000
ESPN_RETRIES=1

# In-memory cache
CACHE_MAX_ENTRIES=500

# Timezone used to decide which day a match belongs to (/v1/matches)
DEFAULT_TZ=America/Sao_Paulo

# Comma separated. Empty = only the 0-40 web app (lovefortyoficial.com, *.vercel.app, localhost)
CORS_ORIGINS=

# Requests per minute per client IP
# RATE_LIMIT_PER_MINUTE=300

# /v1/raw passthrough (default: on in dev, off when NODE_ENV=production)
# ENABLE_RAW=false

# Opcional: guarda as fotos resolvidas (tabela pro_player_photos) para sobreviver a reinícios.
# Chave PÚBLICA (anon) + segredo só de escrita de fotos (private.app_secrets.photos_writer_key).
# Nunca a service role (SEC-14).
SUPABASE_URL=
SUPABASE_ANON_KEY=
PHOTOS_WRITER_KEY=
